# =============================================================================
# .env.compose.example — PLANTILLA de las variables de compose. Sin valores.
# =============================================================================
# Copiar a .env.compose (no se versiona) y usar con:
#   docker compose --env-file .env.compose up -d
# El .env de Laravel es OTRO archivo (LARAVEL_ENV_FILE) y no va acá.
# Vacío = el valor por defecto de compose.yaml.

# Etiqueta de la imagen facturacion-app (por defecto: local).
APP_IMAGE_TAG=

# Puerto publicado en la red local (por defecto 80; los lectores ESP32 usan el 80).
WEB_PUERTO=

# Dominio público del túnel, como ServerAlias de Apache (por defecto un ejemplo).
APACHE_DOMINIO_PUBLICO=

# Carpetas y archivos del host (por defecto bajo /srv/facturacion/).
LARAVEL_ENV_FILE=
BACKUPS_DIR=
FIRMADOR_JAR_DIR=
FIRMADOR_CERT_DIR=

# MySQL del compose. SECRETOS. DB_DATABASE, DB_USERNAME y DB_PASSWORD del .env de
# Laravel tienen que coincidir con los tres primeros.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Token del túnel de Cloudflare. SECRETO.
CLOUDFLARED_TOKEN=

# Solo para compose.local.yaml (máquina de prueba): puerto web (por defecto 8088).
WEB_PUERTO_LOCAL=
