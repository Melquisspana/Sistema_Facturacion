# =============================================================================
# .env.compose.example — PLANTILLA de las variables de compose. Sin valores.
# =============================================================================
# Copiar a .env.compose (no se versiona) y usar con:
#   docker compose --env-file .env.compose up -d
# El .env de Laravel es OTRO archivo (LARAVEL_ENV_FILE) y no va acá.
# Vacío = el valor por defecto de compose.yaml.

# Etiqueta de la imagen facturacion-app (por defecto: local).
APP_IMAGE_TAG=

# Puerto publicado en la red local (por defecto 80; los lectores ESP32 usan el 80).
WEB_PUERTO=

# Dominio público del túnel, como ServerAlias de Apache (por defecto un ejemplo). Tiene
# que coincidir con APP_URL del .env de Laravel: los enlaces de los correos salen con él.
APACHE_DOMINIO_PUBLICO=

# Otros Host que atiende Apache, separados por espacios: la IP del servidor en la red
# local y el nombre .ts.net de Tailscale. facturacion.test y localhost ya están.
# Cualquier otro Host recibe 404.
APACHE_HOSTS_EXTRA=

# HTTPS de la red local, para entrar sin internet (contingencia). Ver «HTTPS de la red
# local» en docs/MIGRACION_LINUX_DOCKER.md. Se enciende solo si están las dos variables
# y lan.crt y lan.key en LAN_TLS_DIR; si falta algo, el 443 queda cerrado y el 80 igual.
# WEB_IP_LAN: la IP del servidor en la red local (la de la reserva de DHCP), por ejemplo
# 192.0.2.10. El 443 se publica solo en esa IP y Apache la acepta como Host. Vacía: el
# 443 queda en 127.0.0.1, fuera de la red. Nunca 0.0.0.0.
WEB_IP_LAN=
# LAN_SUBNET: la red de la oficina, la única que entra por el 443; por ejemplo
# 192.0.2.0/24. Nunca una red de Docker (172.16.0.0/12).
LAN_SUBNET=
# Carpeta del host con lan.crt y lan.key (por defecto /srv/facturacion/tls).
LAN_TLS_DIR=

# Carpetas y archivos del host (por defecto bajo /srv/facturacion/). El .env de Laravel
# va con chown root:33 y chmod 0640 (nunca 0644); si www-data no lo puede leer, los
# contenedores no arrancan.
LARAVEL_ENV_FILE=
BACKUPS_DIR=
FIRMADOR_JAR_DIR=
FIRMADOR_CERT_DIR=

# MySQL del compose. SECRETOS. DB_DATABASE, DB_USERNAME y DB_PASSWORD del .env de
# Laravel tienen que coincidir con los tres primeros.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Token del túnel de Cloudflare. SECRETO.
CLOUDFLARED_TOKEN=

# Solo para compose.local.yaml (máquina de prueba): puerto web (por defecto 8088) y el
# del HTTPS de la red local, solo en 127.0.0.1 (por defecto 8443). En la máquina de
# prueba LAN_TLS_DIR vale por defecto ./tmp/docker-local/tls.
WEB_PUERTO_LOCAL=
WEB_PUERTO_LOCAL_HTTPS=
