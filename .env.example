# =============================================================================
# .env.example — PLANTILLA. Nunca contiene valores reales ni secretos.
# =============================================================================
# Cómo leer este archivo:
#   - una clave con valor  = default razonable, se puede dejar así;
#   - una clave vacía      = hay que completarla en el .env real del entorno;
#   - una clave comentada  = existe y es configurable, pero NO se toca salvo que
#                            sepas exactamente por qué (ver la nota de cada bloque).
#
# NO configurar normalmente (dejarlos como vienen salvo instrucción explícita):
#   APP_KEY (lo genera `php artisan key:generate`), BCRYPT_ROUNDS, SESSION_*,
#   CACHE_STORE, QUEUE_CONNECTION, FILESYSTEM_DISK, BACKUP_DIARIO_ROOT,
#   DTE_TRANSMISION_TOKEN, y todo el bloque CLOUDFLARE_ACCESS_* fuera del servidor
#   público. Cambiarlos sin necesidad rompe sesiones, colas o el acceso al sitio.
#
# Después de editar el .env real: `php artisan config:clear` (o `config:cache`) Y
# reiniciar el worker de cola — el worker tiene su propia copia en memoria.
# =============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos. El proyecto corre sobre MySQL/MariaDB (no sqlite): estas cinco
# claves son OBLIGATORIAS en cualquier despliegue real. La contraseña va SOLO en el
# .env del entorno, nunca aquí.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Ruta a los binarios del cliente MySQL (mysqldump) si no están en el PATH del
# usuario que corre PHP. Necesaria para `backup:mysql-diario` en algunos servidores.
# DB_DUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Seguridad (cabeceras y políticas) — ver config/security.php
# -----------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
CSP_REPORT_ONLY=false
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1

# -----------------------------------------------------------------------------
# DTE / Hacienda — ver config/dte.php (SIN credenciales reales todavía)
# -----------------------------------------------------------------------------
DTE_AMBIENTE=00
# Punto de venta predeterminado del sistema nuevo, por código (ver config/dte.php).
# Vacío = comportamiento anterior (auto-resuelve solo si hay un único punto de venta activo).
DTE_PUNTO_VENTA_PREDETERMINADO=P002
DTE_FIRMADOR_URL=http://localhost:8080/firmardocumento
DTE_STORAGE_DISK=local
# Contraseña del certificado de firma (<NIT>.crt del firmador). SECRETO: solo en el
# .env del entorno. Es la ÚNICA clave para esto — las antiguas DTE_API_USER /
# DTE_API_PASSWORD se eliminaron porque no las leía ningún consumidor.
DTE_CERT_PASSWORD=
# Endpoints del MH por ambiente. Vacío = el servicio usa el host por defecto que
# corresponda al ambiente (apitest.dtes.mh.gob.sv / api.dtes.mh.gob.sv).
DTE_TEST_AUTH_URL=
DTE_TEST_RECEPCION_URL=
# Anulación de pruebas: ÚNICA definición de esta clave en el archivo (antes estaba
# dos veces, aquí vacía y otra vez más abajo con valor: ganaba la segunda).
DTE_TEST_ANULACION_URL=https://apitest.dtes.mh.gob.sv/fesv/anulardte
DTE_TEST_CONSULTA_URL=
DTE_PROD_AUTH_URL=
DTE_PROD_RECEPCION_URL=
DTE_PROD_ANULACION_URL=
DTE_PROD_CONSULTA_URL=

# Factura de Exportación (FEX, tipo 11): recinto fiscal por defecto (CAT-027) para una
# FEX NUEVA (manual o desde Lista de Empaque). El usuario puede cambiarlo en el editor
# antes de generar; NO afecta FEX ya existentes. 01 = Terrestre San Bartolo (confirmado
# con FEX #130 y #143 aceptadas realmente por el MH).
DTE_FEX_RECINTO_FISCAL_DEFAULT=01

# Firma local (firmador del MH). DESHABILITADA por defecto. SIN secretos reales aquí:
# el certificado <NIT>.crt va en uploads/ del firmador; la contraseña SOLO en tu .env local.
DTE_FIRMA_ENABLED=false
DTE_FIRMA_NIT=
# DTE_CERT_PASSWORD ya está arriba (déjalo vacío en este archivo de ejemplo).

# Transmisión a Hacienda (recepción). DESHABILITADA por defecto. SIN credenciales reales aquí.
DTE_TRANSMISION_ENABLED=false
# Candados de seguridad ANTES de cualquier transmisión real (mantener así por ahora):
DTE_TRANSMISION_REAL_CONFIRMATION=false
DTE_TRANSMISION_ALLOW_PRODUCTION=false
DTE_TRANSMISION_DRY_RUN=true
# Candado DEDICADO de pruebas: habilita la transmisión real SOLO a apitest cuando
# DTE_TRANSMISION_AMBIENTE=testing. No abre producción. Default false.
DTE_TRANSMISION_TEST_ENABLED=false
# Candado SOLO para `dte:auth-test` (login real contra apitest; NO habilita transmisión):
DTE_AUTH_TEST_REAL_ENABLED=false
# Candado SEPARADO para `dte:auth-test --prod` (login-only contra producción para
# diagnosticar si la credencial es de producción; NO cachea token, NO transmite):
DTE_AUTH_TEST_PROD_ENABLED=false
# El sistema ACTUAL de facturación sigue siendo el oficial en uso.
DTE_SISTEMA_ACTUAL_ACTIVO=true
# Modo de operación del sistema nuevo: paralelo (seguro) | respaldo | principal.
DTE_MODO_OPERACION=paralelo
DTE_TRANSMISION_AMBIENTE=testing
DTE_TRANSMISION_URL=
DTE_TRANSMISION_ENDPOINT_AUTH=/seguridad/auth
DTE_TRANSMISION_ENDPOINT_RECEPCION=/fesv/recepciondte
DTE_TRANSMISION_TIMEOUT=15
DTE_TRANSMISION_USER_AGENT=DulcesLaNegrita-DTE/1.0
DTE_TRANSMISION_USER=
DTE_TRANSMISION_PASSWORD=
DTE_TRANSMISION_TOKEN=

# Credenciales SEPARADAS por ambiente: producción y apitest/homologación son
# cuentas DISTINTAS en Hacienda. Producción cae de vuelta a DTE_TRANSMISION_USER/
# PASSWORD (arriba) mientras no se definan estas; testing NUNCA usa ese fallback
# — si faltan, se bloquea explícito antes de cualquier HTTP.
DTE_PROD_USER=
DTE_PROD_PASSWORD=
DTE_TEST_USER=
DTE_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# MODO MOCK / SIMULADO (solo para probar el flujo en LOCAL, sin producción)
# -----------------------------------------------------------------------------
# Con estos flags el sistema SIMULA firma y respuesta de Hacienda SIN claves
# reales, SIN certificado, SIN credenciales y SIN HTTP real. Los artefactos
# (JWS y sello) se generan FICTICIOS y marcados; NO valen ante Hacienda.
# Dejar en false en el ejemplo; activarlos solo en tu .env local de pruebas.
DTE_FIRMADOR_MOCK=false
MH_MOCK=false

# -----------------------------------------------------------------------------
# INVALIDACIÓN OFICIAL (evento /fesv/anulardte) — anular un DTE ya aceptado
# -----------------------------------------------------------------------------
# Fase C (mock): firma SIMULADA del evento y persistencia, sin transmitir.
DTE_INVALIDACION_MOCK=false
# Fase D (real): candado de la transmisión real a apitest. Debe ser true (además de
# apagar el mock y pasar --transmitir-real --confirmo-invalidar). Nunca abre producción.
DTE_INVALIDACION_REAL_CONFIRMATION=false
# El endpoint de anulación (DTE_TEST_ANULACION_URL) se define UNA sola vez, arriba,
# junto con los demás endpoints del MH. No lo repitas aquí.
# CANDADO DEDICADO de producción para la invalidación real. Mientras sea false, un DTE
# con ambiente='01' NUNCA se puede invalidar, sin importar el resto de candados. Es un
# flag crítico y hasta ahora no estaba documentado en este archivo.
DTE_INVALIDACION_PRODUCCION_ENABLED=false
# Versión del schema del evento (invalidacion-schema-v3).
DTE_INVALIDACION_VERSION=3
# Overrides SOLO si el MH confirma que difieren de los internos M001/P001 (vacío = internos).
DTE_INVALIDACION_COD_ESTABLE_MH=
DTE_INVALIDACION_COD_PUNTO_VENTA_MH=
# Datos del RESPONSABLE (quien realiza el evento) y del SOLICITANTE (quien lo pide).
# OBLIGATORIOS ante el MH. NO son datos de ejemplo: complételos con datos REALES.
# tipo_doc = CAT-022 (36=NIT, 13=DUI). Si faltan, el preflight BLOQUEA.
DTE_INVALIDACION_RESP_NOMBRE=
DTE_INVALIDACION_RESP_TIPO_DOC=
DTE_INVALIDACION_RESP_NUM_DOC=
DTE_INVALIDACION_SOL_NOMBRE=
DTE_INVALIDACION_SOL_TIPO_DOC=
DTE_INVALIDACION_SOL_NUM_DOC=

# Documentos PROTEGIDOS como evidencia (p.ej. cierre de una fase de pruebas en
# APITEST): NUNCA se pueden invalidar por esta vía (mock ni real), sin excepción.
# Listas separadas por comas de número de control (preferido, estable) o código de
# generación. Vacío = nada protegido. NO son secretos (identificadores fiscales
# públicos del propio documento, no credenciales).
DTE_INVALIDACION_PROTEGIDOS_NUMERO_CONTROL=
DTE_INVALIDACION_PROTEGIDOS_CODIGO_GENERACION=

# Nombres alternativos sugeridos para el modo mock. En este proyecto ya existen
# con prefijo DTE_* (arriba); se documentan aquí su equivalencia, NO se duplican:
#   DTE_FIRMADOR_ENABLED  -> DTE_FIRMA_ENABLED (interruptor de firma real)
#   DTE_FIRMADOR_URL      -> DTE_FIRMADOR_URL / DTE_FIRMA_URL (URL del firmador)
#   MH_API_URL            -> DTE_TRANSMISION_URL (+ DTE_TEST_RECEPCION_URL)
#   MH_AUTH_URL           -> DTE_TEST_AUTH_URL (+ DTE_TRANSMISION_ENDPOINT_AUTH)
#   MH_USER               -> DTE_PROD_USER / DTE_TEST_USER según el ambiente
#   MH_PASSWORD           -> DTE_PROD_PASSWORD / DTE_TEST_PASSWORD según el ambiente
#   MH_NIT                -> DTE_FIRMA_NIT

# -----------------------------------------------------------------------------
# Emisor — RESPALDO DE PRESENTACIÓN ÚNICAMENTE (ver config/company.php)
# -----------------------------------------------------------------------------
# NO es la fuente de verdad del emisor: los datos fiscales que van al JSON del MH
# salen de la tabla `empresas` (Configuración → Empresa emisora). Estas claves solo
# rellenan huecos en el PDF y en la vista de impresión si la empresa no tiene el dato
# cargado. Cambiarlas no cambia nada de lo que se le envía a Hacienda.
COMPANY_NIT=
COMPANY_NRC=
COMPANY_NAME="Dulces La Negrita"
COMPANY_TRADE_NAME="Dulces La Negrita"
COMPANY_ACTIVITY_CODE=
COMPANY_ACTIVITY_DESC=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_DEPARTMENT=
COMPANY_MUNICIPALITY=
COMPANY_ADDRESS=

# --- Módulo Producción / Planta (área operativa aislada) ---
# Nombre técnico «planta»; etiqueta visible «Producción». Apagado por defecto:
# con false, /planta responde 404 para TODOS los roles y el área no aparece en el
# selector superior. NO tiene relación con el ambiente fiscal de Hacienda ('01')
# ni con APP_ENV: no afecta firma, transmisión ni correlativos.
PLANTA_ENABLED=false

# --- Módulo Prontos Pagos (PPQ) / Gmail (fuente principal de CCF y albaranes) ---
PPQ_GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
PPQ_GMAIL_LABEL=Calleja_Albaranes
# Sala dentro de la OC: dígitos que se saltan (prefijo YYMM) y cuántos se toman.
# OJO: la clave que el código lee es PPQ_SALA_OC_PREFIX. Este archivo documentaba
# PPQ_SALA_OC_OFFSET, que NO la lee nadie: quien la cambiaba no cambiaba nada.
PPQ_SALA_OC_PREFIX=4
PPQ_SALA_OC_LENGTH=4
# Tolerancias de conciliación CCF/NC vs albarán (en valor absoluto de la diferencia).
# PPQ_DIFERENCIA_COINCIDE=0.05
# PPQ_DIFERENCIA_PEQUENA=1.00
# Código que Calleja asigna al emisor. Solo nombra el Excel exportado.
# PPQ_CODIGO_PROVEEDOR=001065

# --- Módulo Documentos recibidos (CCF/facturas de proveedores por correo) ---
# Fuente INDEPENDIENTE de Gmail/PPQ: buzón Yahoo por IMAP en SOLO LECTURA (no borra,
# no mueve, no marca leído). Sin credenciales, la revisión queda deshabilitada.
# Las contraseñas van SOLO en .env real, nunca en este ejemplo ni en el repo.
DOCUMENTOS_RECIBIDOS_MAIL_DRIVER=imap
DOCUMENTOS_RECIBIDOS_MAIL_HOST=
DOCUMENTOS_RECIBIDOS_MAIL_PORT=993
DOCUMENTOS_RECIBIDOS_MAIL_ENCRYPTION=ssl
DOCUMENTOS_RECIBIDOS_MAIL_USERNAME=
DOCUMENTOS_RECIBIDOS_MAIL_PASSWORD=
DOCUMENTOS_RECIBIDOS_MAIL_FOLDER=INBOX
# Opcionales con default razonable. Descomentar solo si hace falta ajustarlos.
# DOCUMENTOS_RECIBIDOS_MAIL_SEARCH=ALL
# DOCUMENTOS_RECIBIDOS_MAIL_TIMEOUT=15
# DOCUMENTOS_RECIBIDOS_LIMITE=30

# -----------------------------------------------------------------------------
# Respaldos (ver config/backup_diario.php y config/backup.php)
# -----------------------------------------------------------------------------
# Retención de los dumps AUTOMÁTICOS (prefijo "auto-") de `backup:mysql-diario`.
# Los dumps manuales que ya existan en backups/ NUNCA se borran por retención.
BACKUP_DIARIO_DIAS_RETENCION=30
# Reintentos si mysqldump falla por el error intermitente de socket en Windows.
BACKUP_DIARIO_REINTENTOS=2
BACKUP_DIARIO_REINTENTOS_ESPERA=3
# Carpeta de los dumps. NO cambiar salvo que el disco del servidor lo exija:
# el default es backups/ en la raíz del proyecto, ya excluida de git.
# BACKUP_DIARIO_ROOT=
# Contraseña del ZIP de spatie/laravel-backup. SECRETO: solo en el .env del entorno.
# Vacío = el ZIP queda SIN cifrar.
BACKUP_ARCHIVE_PASSWORD=
# Destinatario de los avisos de backup (fallo, backup no saludable, limpieza fallida).
# Sin esto, un backup que falla no avisa a nadie. Ver también config/backup.php.
BACKUP_NOTIFICACIONES_CORREO=

# -----------------------------------------------------------------------------
# Módulo Rutas / Cobros (ver config/rutas.php) — no toca emisión ni correlativos
# -----------------------------------------------------------------------------
# Ventana de fechas para proponer documentos candidatos a una salida.
# RUTAS_CANDIDATOS_DIAS_ANTES=15
# RUTAS_CANDIDATOS_DIAS_DESPUES=15
# Serie habilitada para la ASIGNACIÓN AUTOMÁTICA. Vacío = todo manual.
# P001 (Conta Portable) nunca se asocia sola, a propósito.
# RUTAS_PUNTO_VENTA_AUTOMATICO=P002
# Alcance por defecto del barrido de `rutas:asociar-documentos` y de la bandeja.
# RUTAS_ASOCIACION_DIAS=7
# RUTAS_BANDEJA_DIAS=60

# -----------------------------------------------------------------------------
# Exportaciones / Lista de empaque (ver config/exportaciones.php)
# -----------------------------------------------------------------------------
# Valores por defecto del encabezado al crear una exportación (editables en el
# formulario). Son datos de la empresa, no secretos.
# EXPORTACIONES_EXPORTADOR=
# EXPORTACIONES_EXPORTADOR_DIR=
# EXPORTACIONES_FDA=
# EXPORTACIONES_PLANTILLA=templates/exportaciones/lista_empaque.xlsx

# -----------------------------------------------------------------------------
# Acceso público / Cloudflare Access (ver config/cloudflare_access.php)
# -----------------------------------------------------------------------------
# SOLO en el servidor del dominio público. En desarrollo se queda apagado y manda el
# login local de Laravel. El AUD no es un secreto (es un identificador de la app en
# Zero Trust), pero debe coincidir EXACTO. Las credenciales del túnel de Cloudflare NO
# van aquí: las administra el daemon del servidor.
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# CLOUDFLARE_ACCESS_ALLOWED_HOST=facturacion.dulceslanegrita.com
# CLOUDFLARE_ACCESS_AUTO_LOGIN=true
# CLOUDFLARE_ACCESS_CERTS_TTL=3600
# CLOUDFLARE_ACCESS_CERTS_TIMEOUT=5
