#ifndef SECRETOS_H
#define SECRETOS_H

// =====================================================
// CONFIGURACION LOCAL DEL LECTOR  -  PLANTILLA
//
// Copiar este archivo como  secretos.h  y rellenarlo con los valores reales.
//
//   copy secretos.h.example secretos.h
//
// secretos.h esta ignorado por Git (ver .gitignore en la raiz del proyecto).
// NUNCA se versiona: lleva la password del Wi-Fi y el token del lector.
//
// El token se obtiene UNA sola vez al dar de alta el lector:
//
//   php artisan asistencia:dispositivo lector-entrada --nombre="Entrada principal"
//
// y se rota (el firmware anterior deja de autenticar) con:
//
//   php artisan asistencia:dispositivo lector-entrada --rotar
// =====================================================


// ===================================================== 
// WIFI
// =====================================================

const char* WIFI_SSID =
  "NOMBRE-DE-LA-RED";

const char* WIFI_PASSWORD =
  "PASSWORD-DE-LA-RED";


// =====================================================
// LARAVEL
//
// SERVER_IP es la IP del servidor en la LAN.
// SERVER_HOST es OBLIGATORIO y tiene que ser el nombre del vhost: Apache sirve
// este proyecto SOLO cuando la peticion llega con  Host: facturacion.test
// Pegarle a la IP sin esa cabecera devuelve el 404 de Laragon, no el de Laravel.
// =====================================================

const char* SERVER_IP =
  "192.168.1.143";

const uint16_t SERVER_PORT =
  80;

const char* SERVER_HOST =
  "facturacion.test";


// =====================================================
// CREDENCIAL DEL LECTOR
//
// Viajan como cabeceras en cada peticion que escribe:
//   X-Dispositivo:        DEVICE_CODE
//   X-Dispositivo-Token:  DEVICE_TOKEN
// =====================================================

const char* DEVICE_CODE =
  "lector-entrada";

const char* DEVICE_TOKEN =
  "PEGAR-AQUI-EL-TOKEN-DEL-LECTOR";


#endif
