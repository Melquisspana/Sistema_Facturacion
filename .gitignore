# Firmador local del MH y material criptográfico (NUNCA versionar)
/resources/firmador/
*.crt
*.p12
*.pfx
*.key
*.pem
# Volcado del certificado de firma del MH (credencial sensible)
/cert.txt

# Backups locales (dumps .sql manuales/automáticos, zips, .bak): nunca versionar
/backups/

# Estado local de las herramientas de asistente (settings.local.json, locks).
# Es configuración de la MÁQUINA de cada quien, no del proyecto.
/.claude/

# Scratch de trabajo (PDFs volcados, renders intermedios). Nada de acá se versiona.
/tmp/

# Firmware del lector de asistencia: secretos locales (SSID, password Wi-Fi,
# token del lector). Solo se versiona la plantilla secretos.h.example.
/firmware/asistencia/secretos.h
/firmware/asistencia_es3c28p/secretos.h
/firmware/asistencia_es3c28p/respaldo_fabrica/

# Evidencias locales de corridas de la suite (JUnit + salida). No se versionan:
# son fotos de un árbol de trabajo concreto, pesan MB y quedan obsoletas al primer
# cambio. Ver evidencias/<carpeta>/README.md.
/evidencias/
